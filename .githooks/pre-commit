#!/bin/sh
# 커밋 전 검사 (vs-git 스킬 "커밋 전 검사").
# 설치: git config core.hooksPath .githooks
# 실패하면 커밋을 막는다. 일치한 값은 출력하지 않는다.

fail() {
    echo "[pre-commit] $1 커밋을 막았습니다."
    exit 1
}

# 1. 제외 대상이 스테이징되었는지
blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)|\.env$|\.pem$|(^|/)CLAUDE\.md$|settings\.local\.json$')
if [ -n "$blocked" ]; then
    echo "$blocked"
    fail "커밋하면 안 되는 파일이 스테이징되어 있습니다."
fi

# 2. 비밀 값 스캔 (작업 폴더 전체)
node .claude/skills/secret-scan/scripts/scan.js || fail "비밀 값 의심 항목이 있습니다."

# 3. 스테이징된 JS 문법 검사
git diff --cached --name-only --diff-filter=ACMR -z -- '*.js' | xargs -0 -r -n1 node --check || fail "JS 문법 오류가 있습니다."

exit 0
